[Unit]
Description=DID API Vendor
After=network.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{WORKING_DIR}}
Environment=PATH={{WORKING_DIR}}/venv/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart={{WORKING_DIR}}/run.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

; Hardening: this service holds Ed25519 private keys, the vendor's Fernet
; secret, and an Ethereum signing key on disk, so lock it down beyond the
; default systemd sandbox.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{WORKING_DIR}}/data {{WORKING_DIR}}/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
